{
  "extends": "./tsconfig.base.json",
  "include": [
    "framework/**/*.ts",
    "framework/**/*.tsx",
    "shared/**/*.ts",
    "shared/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/test/**",
    "**/test-utils/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/vitest.config.ts",
    "**/vitest.cross-repo.config.ts"
  ]
}
