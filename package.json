{
  "name": "@r3e-network/neo-miniapp-sdk",
  "version": "2.2.4",
  "private": true,
  "description": "MiniApp SDK for the Neo MiniApps platform: business framework and shared app runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r3e-network/neo-miniapp-sdk.git"
  },
  "workspaces": [
    "framework",
    "shared"
  ],
  "scripts": {
    "test": "npm run -s test:framework && npm run -s test:shared && npm run -s test:scripts && npm run -s check:platform-surface",
    "test:framework": "npm --workspace framework run test",
    "test:shared": "npm --workspace shared run test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:cross-repo": "npm --workspace framework run test:cross-repo; npm --workspace shared run test:cross-repo",
    "generate:contract-registry": "node scripts/generate-miniapp-contract-registry.mjs",
    "tokenize:palette": "node scripts/tokenize-palette-hex.mjs",
    "audit:platform-surface": "node scripts/audit_platform_surface_parity.mjs",
    "check:platform-surface": "node scripts/audit_platform_surface_parity.mjs --check",
    "test:scripts": "node --test scripts/lib/*.test.mjs"
  },
  "devDependencies": {
    "@douyinfe/semi-ui": "^2.101.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vue/test-utils": "^2.4.6",
    "ethers": "^6.16.0",
    "glob": "^10.5.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.562.0",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass-embedded": "^1.98.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.0",
    "vue": "^3.5.33"
  }
}
