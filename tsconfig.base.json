{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@framework": [
        "./framework/index.ts"
      ],
      "@framework/*": [
        "./framework/*"
      ],
      "@shared": [
        "./shared/components/index.ts"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    },
    "types": [
      "vite/client",
      "vitest/globals"
    ]
  }
}
